          <dc:Bounds x="566" y="208" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Confirmar" bpmnElement="Task_Confirmar">
        <dc:Bounds x="686" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Informar" bpmnElement="Task_Informar">
        <dc:Bounds x="826" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Levar" bpmnElement="Task_Levar">
        <dc:Bounds x="966" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Oferecer" bpmnElement="Task_Oferecer">
        <dc:Bounds x="571" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Aceita" bpmnElement="GW_Aceita">
        <dc:Bounds x="711" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="681" y="343" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cancelado" bpmnElement="End_Cancelado">
        <dc:Bounds x="841" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="804" y="424" width="110" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Fila" bpmnElement="Task_Fila">
        <dc:Bounds x="1106" y="550" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Preparar" bpmnElement="Task_Preparar">
        <dc:Bounds x="1246" y="550" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Assar" bpmnElement="Task_Assar">
        <dc:Bounds x="1386" y="550" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Conferir" bpmnElement="Task_Conferir">
        <dc:Bounds x="1526" y="550" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Conforme" bpmnElement="GW_Conforme">
        <dc:Bounds x="1666" y="565" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1636" y="533" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Embalar" bpmnElement="Task_Embalar">
        <dc:Bounds x="1756" y="550" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Refazer" bpmnElement="Task_Refazer">
