        <dc:Bounds x="2036" y="815" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2006" y="783" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Timer_Aguardar" bpmnElement="Timer_Aguardar">
        <dc:Bounds x="2043" y="922" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2006" y="964" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Despachar" bpmnElement="Task_Despachar">
        <dc:Bounds x="2126" y="800" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Entregar" bpmnElement="Task_Entregar">
        <dc:Bounds x="2266" y="800" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Receber" bpmnElement="Task_Receber">
        <dc:Bounds x="2406" y="800" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RegistrarPag" bpmnElement="Task_RegistrarPag">
        <dc:Bounds x="2546" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Caixa" bpmnElement="Task_Caixa">
        <dc:Bounds x="2686" y="1040" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Concluido" bpmnElement="End_Concluido">
        <dc:Bounds x="2826" y="1062" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2789" y="1104" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Papel" bpmnElement="Note_Papel">
        <dc:Bounds x="225" y="360" width="160" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Comanda" bpmnElement="Note_Comanda">
        <dc:Bounds x="940" y="360" width="200" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Retrabalho" bpmnElement="Note_Retrabalho">
        <dc:Bounds x="1830" y="648" width="200" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Rota" bpmnElement="Note_Rota">
