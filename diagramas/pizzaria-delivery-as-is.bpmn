<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Pizzaria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Modelo didatico" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Pizzaria">
    <bpmn:participant id="Participant_Cliente" name="Cliente" />
    <bpmn:participant id="Participant_Pizzaria" name="Pizzaria" processRef="Process_Pizzaria" />
    <bpmn:messageFlow id="Msg_1" name="Pedido do cliente" sourceRef="Participant_Cliente" targetRef="StartEvent_Pedido" />
    <bpmn:messageFlow id="Msg_2" name="Valor e prazo confirmados" sourceRef="Task_Informar" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="Msg_3" name="Pizza entregue" sourceRef="Task_Entregar" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="Msg_4" name="Pagamento" sourceRef="Participant_Cliente" targetRef="Task_Receber" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pizzaria" name="Atender pedido de delivery (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Pizzaria">
      <bpmn:lane id="Lane_Atendimento" name="Atendimento">
        <bpmn:flowNodeRef>StartEvent_Pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Anotar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Ingredientes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Informar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Levar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Oferecer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Aceita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Cozinha" name="Cozinha">
        <bpmn:flowNodeRef>Task_Fila</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Preparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Conferir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Conforme</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Embalar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Refazer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Expedicao" name="Expedição / Entrega">
        <bpmn:flowNodeRef>Task_Separar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Entregador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Aguardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Despachar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Entregar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receber</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Financeiro" name="Financeiro">
        <bpmn:flowNodeRef>Task_RegistrarPag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Caixa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Concluido</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Pedido" name="Pedido recebido (telefone, WhatsApp ou app)">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_StartEvent_Pedido" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Anotar" name="Anotar pedido no bloco de comandas">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_Consultar" name="Consultar disponibilidade de ingredientes">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_Ingredientes" name="Tem todos os ingredientes?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Confirmar" name="Confirmar endereço e forma de pagamento">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Informar" name="Informar valor e tempo estimado">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_Levar" name="Levar comanda até a cozinha">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_Oferecer" name="Oferecer alternativa ao cliente">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Aceita" name="Cliente aceita a alternativa?">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Cancelado" name="Pedido cancelado">
      <bpmn:incoming>Flow_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Task_Fila" name="Registrar comanda na fila de produção">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="Task_Preparar" name="Preparar massa e cobertura">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Assar" name="Assar a pizza no forno">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:manualTask id="Task_Conferir" name="Conferir pizza contra a comanda">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_Conforme" name="Pizza conforme o pedido?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Embalar" name="Embalar pizza e acompanhamentos">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Refazer" name="Refazer a pizza">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:manualTask id="Task_Separar" name="Separar pedido e definir a rota">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_Entregador" name="Entregador disponível?">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Timer_Aguardar" name="Aguardar retorno de um entregador">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_Aguardar" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Despachar" name="Despachar entregador com o pedido">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_Entregar" name="Entregar pedido ao cliente">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Receber" name="Receber pagamento na entrega">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_RegistrarPag" name="Registrar recebimento na planilha">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Caixa" name="Conferir caixa no fim do turno">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_Concluido" name="Pedido entregue e pago">
      <bpmn:incoming>Flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Pedido" targetRef="Task_Anotar" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Anotar" targetRef="Task_Consultar" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Consultar" targetRef="GW_Ingredientes" />
    <bpmn:sequenceFlow id="Flow_04" name="Sim" sourceRef="GW_Ingredientes" targetRef="Task_Confirmar" />
    <bpmn:sequenceFlow id="Flow_05" name="Não" sourceRef="GW_Ingredientes" targetRef="Task_Oferecer" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Oferecer" targetRef="GW_Aceita" />
    <bpmn:sequenceFlow id="Flow_07" name="Não" sourceRef="GW_Aceita" targetRef="End_Cancelado" />
    <bpmn:sequenceFlow id="Flow_08" name="Sim, refaz o pedido" sourceRef="GW_Aceita" targetRef="Task_Anotar" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Confirmar" targetRef="Task_Informar" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Informar" targetRef="Task_Levar" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Levar" targetRef="Task_Fila" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Fila" targetRef="Task_Preparar" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Preparar" targetRef="Task_Assar" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Assar" targetRef="Task_Conferir" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Conferir" targetRef="GW_Conforme" />
    <bpmn:sequenceFlow id="Flow_16" name="Sim" sourceRef="GW_Conforme" targetRef="Task_Embalar" />
    <bpmn:sequenceFlow id="Flow_17" name="Não" sourceRef="GW_Conforme" targetRef="Task_Refazer" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Refazer" targetRef="Task_Assar" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Embalar" targetRef="Task_Separar" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Separar" targetRef="GW_Entregador" />
    <bpmn:sequenceFlow id="Flow_21" name="Sim" sourceRef="GW_Entregador" targetRef="Task_Despachar" />
    <bpmn:sequenceFlow id="Flow_22" name="Não" sourceRef="GW_Entregador" targetRef="Timer_Aguardar" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Timer_Aguardar" targetRef="GW_Entregador" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Despachar" targetRef="Task_Entregar" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_Entregar" targetRef="Task_Receber" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Receber" targetRef="Task_RegistrarPag" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_RegistrarPag" targetRef="Task_Caixa" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_Caixa" targetRef="End_Concluido" />
    <bpmn:textAnnotation id="Note_Papel">
      <bpmn:text>AS-IS: pedido anotado à mão, sem registro digital — erro de item e retrabalho.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="Task_Anotar" targetRef="Note_Papel" />
    <bpmn:textAnnotation id="Note_Comanda">
      <bpmn:text>AS-IS: a comanda de papel circula fisicamente entre salão e cozinha; pode se perder.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_2" sourceRef="Task_Levar" targetRef="Note_Comanda" />
    <bpmn:textAnnotation id="Note_Retrabalho">
      <bpmn:text>AS-IS: retrabalho — insumo perdido e pedido atrasado.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_3" sourceRef="Task_Refazer" targetRef="Note_Retrabalho" />
    <bpmn:textAnnotation id="Note_Rota">
      <bpmn:text>AS-IS: fila e rota definidas verbalmente, sem roteirização.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_4" sourceRef="Timer_Aguardar" targetRef="Note_Rota" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Pizzaria">
      <bpmndi:BPMNShape id="Shape_Cliente" bpmnElement="Participant_Cliente" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2800" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Pizzaria" bpmnElement="Participant_Pizzaria" isHorizontal="true">
        <dc:Bounds x="160" y="200" width="2800" height="960" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Atendimento" bpmnElement="Lane_Atendimento" isHorizontal="true">
        <dc:Bounds x="190" y="200" width="2770" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Cozinha" bpmnElement="Lane_Cozinha" isHorizontal="true">
        <dc:Bounds x="190" y="500" width="2770" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Expedicao" bpmnElement="Lane_Expedicao" isHorizontal="true">
        <dc:Bounds x="190" y="760" width="2770" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Financeiro" bpmnElement="Lane_Financeiro" isHorizontal="true">
        <dc:Bounds x="190" y="1000" width="2770" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_Pedido" bpmnElement="StartEvent_Pedido">
        <dc:Bounds x="240" y="247" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="203" y="289" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Anotar" bpmnElement="Task_Anotar">
        <dc:Bounds x="316" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Consultar" bpmnElement="Task_Consultar">
        <dc:Bounds x="456" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Ingredientes" bpmnElement="GW_Ingredientes">
        <dc:Bounds x="596" y="240" width="50" height="50" />
